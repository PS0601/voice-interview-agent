# Copy this file to .env.local and fill in your keys. Never commit .env.local.

# LiveKit Cloud (cloud.livekit.io -> your project -> Settings -> API Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM (platform.deepseek.com)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Speech-to-text (console.deepgram.com) and text-to-speech (play.cartesia.ai)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Optional
# COMPANY_PDF_PATH=./company_profile.pdf
# CHROMA_DIR=./chroma_store
# AGENT_NAME=interview-agent      # set to require explicit dispatch
# BEY_API_KEY=                    # Beyond Presence avatar (leave unset for voice-only)
# BEY_AVATAR_ID=
